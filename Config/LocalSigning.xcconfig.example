// Copy to LocalSigning.xcconfig (gitignored) and select one installed identity.
// Keep the same identity and bundle identifier across local builds.
CODE_SIGN_IDENTITY = YOUR_CERTIFICATE_SHA1
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
// Developer ID notarization requires a secure timestamp.
OTHER_CODE_SIGN_FLAGS = --timestamp
